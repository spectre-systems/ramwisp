# Copie para server/.env e preencha. Nunca faça commit do .env.
PORT=4800
PUBLIC_URL=https://your-domain.example
AGENT_API_URL=https://your-domain.example
LAUNCHER=ec2                 # "local" roda a enclave emulada em Docker (desenvolvimento)
AWS_PROFILE=your-aws-profile
AWS_REGION=us-east-1
# preenchidos por infra/setup.sh:
ARTIFACT_BUCKET=
INSTANCE_PROFILE=wisp-parent
SECURITY_GROUP_ID=
SUBNET_IDS=
MAX_INSTANCES=1
MAX_VCPUS=5
SIGNUP_CREDIT_CENTS=300
FREE_POOL_CENTS=6000
# opcional: pagamentos (infra/stripe-setup.sh cria o webhook e grava o segredo)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
